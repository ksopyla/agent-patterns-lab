# LLM Providers
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.1-chat-agent-lab
AZURE_OPENAI_API_VERSION=2025-01-01-preview
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Change this to decide which LLM provider to use: azure_openai or anthropic
LLM_PROVIDER=azure_openai

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-patterns-lab
LANGSMITH_TRACING=false

# Auth (Pattern 07+)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# MCP Servers
GITHUB_PERSONAL_ACCESS_TOKEN=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
DATABASE_URL=

# Debug
VERBOSE=true
